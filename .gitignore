.DS_Store

# BLOOM v1 local development state. Legacy Pony files remain visible so the
# pond/ -> pony/ rename preserves every tracked prototype artifact.
archive/v1/**/.env
archive/v1/**/.venv/
archive/v1/**/__pycache__/
archive/v1/**/*.py[cod]
archive/v1/**/.pytest_cache/

# ESP-IDF / PlatformIO build output
build/
.pio/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# BLOOM v1 Garden runtime data and private media
archive/v1/**/.bloom-data/
archive/v1/**/debug_audio/
archive/v1/**/*.wav

# Python caches (all generations)
__pycache__/
*.py[cod]
