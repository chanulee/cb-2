# Copy to mac-server/.env and fill in real values.
# .env is gitignored; NEVER commit real secrets.

# Speech-to-text backend: "mistral" or "whisper"
STT_BACKEND=mistral

# Required when STT_BACKEND=mistral
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=UnRDIIuwPdcDJPR7AAGjJSPFPR3yIQLl

# Optional: override the Mistral transcription model
MISTRAL_STT_MODEL=voxtral-mini-latest

# Optional: override Ollama model used for chat
OLLAMA_MODEL=qwen3.5:9b
# Leave blank so describe_image reuses OLLAMA_MODEL (qwen3.5 is multimodal).
OLLAMA_VISION_MODEL=
AGENT_ROOT=~/Desktop/pony_agent